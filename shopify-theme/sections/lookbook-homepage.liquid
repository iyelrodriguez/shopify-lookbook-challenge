{{ 'lookbook.css' | asset_url | stylesheet_tag }}

{% assign selected_lookbook = section.settings.lookbook %}

<div
  id="lookbook-products"
  data-title="{{ selected_lookbook.lookbook_title | escape }}"
  data-description="{{ selected_lookbook.lookbook_description | escape }}"
  data-show-description="{{ section.settings.show_description }}"
  data-show-compare-price="{{ section.settings.show_compare_price }}"
  data-products-per-row="{{ section.settings.products_per_row }}"
  data-padding-top="{{ section.settings.padding_top }}"
  data-padding-bottom="{{ section.settings.padding_bottom }}"
  data-product-handles="{% for handle in selected_lookbook.product_handle_lookbook.value %}{{ handle }}{% unless forloop.last %},{% endunless %}{% endfor %}">
</div>

<div id="lookbook-react-root"></div>

<script
  type="module"
  src="{{ 'lookbook-react.js' | asset_url }}">
</script>
{% schema %}
{
  "name": "Homepage Lookbook",
  "settings": [
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "Select Lookbook",
      "metaobject_type": "lookbook"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show Compare At Price",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products Per Row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Homepage Lookbook"
    }
  ]
}
{% endschema %}